    "color": "Which side this entry represents/owns: 'White' or 'Black'.",
    "pgn": "Canonical move sequence reaching this opening, in SAN.",
    "depthOfTheory": "Hard filter. One of 'Shallow' | 'Moderate' | 'Deep'. One value per entry — an opening family spanning multiple depths is represented by multiple entries at different ECO codes, not a range on one entry.",
    "timeControls": "Hard filter. Array of eligible values from ['Bullet/Blitz', 'Rapid', 'Classical/Correspondence'].",
    "ratingBand": "Soft-scored. Integer 1-5, matching the user rating taxonomy: 1=Beginner, 2=Intermediate, 3=Advanced, 4=Expert, 5=Master. Compared via distance against the user's own band value.",
    "style": {
      "tacticalVsPositional": "Soft-scored. Integer -2..+2. -2 = strongly positional, +2 = strongly tactical.",
      "riskTolerance": "Soft-scored. Integer -2..+2. -2 = very solid/safe, +2 = very sharp/gambit-friendly.",
      "dynamicVsStatic": "Soft-scored. Integer -2..+2. -2 = strongly static (stable structures), +2 = strongly dynamic (imbalanced, initiative-chasing structures).",
      "forgivingVsPunishing": "Soft-scored. Integer -2..+2. -2 = very forgiving (mistakes stay recoverable), +2 = very punishing (one inaccuracy can be immediately losing)."
    },
    "healthAtHigherLevels": "Soft-scored (drives the Longevity criterion). Integer -2..+2. -2 = known to be dubious/refuted against strong opposition, +2 = a mainstay even at elite level. Not a boolean — graded to avoid forcing an all-or-nothing 'is this bad' call.",
    "estimatedHoursToCompetency": "Not filtered or scored directly. Divided by the user's daily study-time budget to personalize the rationale line (e.g. 'about 2 weeks at your pace')."
  },
